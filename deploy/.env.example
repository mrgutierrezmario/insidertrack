# Copy to deploy/.env — start.sh does this and fills in the secrets on first run.

# Internal database password (user stockuser, db stocktracker are fixed in compose.yml).
DB_PASSWORD=

# Public URL: https://<TS_HOSTNAME>.<your tailnet>.ts.net
TS_HOSTNAME=stock-tracker
# Optional: a Tailscale auth key (admin console > Settings > Keys) lets the stack
# join without the interactive login link. Leave blank to use the link.
TS_AUTHKEY=
# The full public hostname (no scheme) — used by the CORS allowlist.
PUBLIC_DOMAIN=

# Local port for http://localhost:<APP_PORT> access on the Mac / LAN.
APP_PORT=8013

# Password for the /admin login. Generated on first run if left blank.
ADMIN_PASSWORD=

# External APIs (optional). AI keys are usually set in Admin → AI research
# notes instead; these are the fallback defaults.
ALPHA_VANTAGE_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Local model server, no key — free and unlimited. Native Ollama on the same
# Mac (brew install ollama; ollama pull llama3) is reachable from the container at:
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3
# Which provider writes the daily Model Desk brief (ollama = free).
AI_BATCH_PROVIDER=ollama
OPENAI_API_KEY=
# claude | gemini | openai — who writes research notes (others are fallbacks)
AI_PROVIDER=claude
# Max fresh notes per UTC day charged to the site's keys (visitor keys excluded)
AI_DAILY_CAP=150

# Digest / alert emails (optional). Gmail address + App Password from
# myaccount.google.com/apppasswords. Blank = emails are skipped.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=InsiderTrack
# Optional: address replies go to (useful when MAIL_FROM is a do-not-reply account).
MAIL_REPLY_TO=
# Operational notices (a data source failing or gone quiet, a failed host
# backup). Defaults to the sender.
MAIL_ADMIN_TO=

# Host-side backups (deploy/backup.sh). Defaults are fine; see README.
#BACKUP_DIR=
#RCLONE_REMOTE=stock-tracker-backup:
