# InsiderTrack — environment variables
# Copy to .env (same directory) and fill in the values you need.
# Anything left blank uses the defaults baked into backend/config.py.

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres connection. Use 5432 for local PostgreSQL, 5433 for the Docker DB
# from docker-compose.yml. The username/password/db must match POSTGRES_* below.
DATABASE_URL=postgresql://stockuser:stockpass@localhost:5432/stocktracker

# Docker Compose reads these to provision the `db` service when start.sh falls
# back to the dockerised Postgres.
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=stockpass
POSTGRES_DB=stocktracker

# ── Ports (used by start.sh / docker-compose) ─────────────────────────────────
BACKEND_PORT=8003
FRONTEND_PORT=5176

# ── External APIs (optional) ──────────────────────────────────────────────────
# Alpha Vantage — intraday charts, news sentiment. Free tier is fine.
# Without this, intraday charts and the sentiment sub-score are disabled.
ALPHA_VANTAGE_KEY=

# AI research notes on /ticker/<TICKER> — Claude, Gemini or OpenAI. Usually
# set in Admin → AI research notes; these are the fallback defaults.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# claude | gemini | openai — who writes the note (others are fallbacks)
AI_PROVIDER=claude
# Max fresh notes per UTC day charged to the site's keys (visitor keys excluded)
AI_DAILY_CAP=150

# ── Admin auth ────────────────────────────────────────────────────────────────
# Password for the /admin login (httpOnly cookie, 1-hour expiry).
# CHANGE THIS in production. Default in config.py is "191919".
ADMIN_PASSWORD=

# Set true only behind HTTPS (production: the deploy/ stack sets this itself).
# Leave false / unset in plain-HTTP dev or the browser silently drops the
# admin cookie and login appears to fail.
COOKIE_SECURE=false

# Public hostname (no scheme) for the CORS allowlist. In production the
# deploy/ stack sets it to the Tailscale Funnel host; leave blank in dev.
PUBLIC_DOMAIN=

# ── Email reports (optional) ──────────────────────────────────────────────────
# SMTP credentials for the 08:00 / 12:00 / 18:00 ET digest emails.
# Without MAIL_PASSWORD, the scheduler still runs but emails are skipped.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=InsiderTrack
# Optional: address replies go to (useful when MAIL_FROM is a do-not-reply account).
MAIL_REPLY_TO=
# Operational notices (a data source failing or gone quiet). Defaults to the sender.
MAIL_ADMIN_TO=
